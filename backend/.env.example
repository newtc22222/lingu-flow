# LinguFlow Python Backend Environment Variables
PORT=8000
ENVIRONMENT=development

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/linguflow

# Redis (Cache & Session)
REDIS_URL=redis://localhost:6379/0

# Security (REQUIRED: Must be set in production!)
JWT_SECRET=change_this_to_a_long_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=

# AI Provider Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
