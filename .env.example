# Compose-oriented local defaults (docker-compose.yml).
# Full backend env list (OAuth, R2, Redis, etc.): see backend/.env.example

# Docker & Local Ports
POSTGRES_HOST_PORT=5432
PORT=8000

# Backend Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/linguflow
JWT_SECRET=your_jwt_secret_key_here
ENVIRONMENT=development
