{
  "name": "lingu-flow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && .\\venv\\Scripts\\python -m uvicorn app.main:app --port 8000 --reload",
    "build:frontend": "npm run build --prefix frontend",
    "format:frontend": "npm run format --prefix frontend",
    "format:backend": "prettier --write --ignore-path backend/.prettierignore backend",
    "format:check:backend": "prettier --check --ignore-path backend/.prettierignore backend"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
